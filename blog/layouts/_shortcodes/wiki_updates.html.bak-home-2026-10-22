{{- /* Kartu "Update Wiki" — membaca data/wiki_updates.json (dibuat tools/wiki_update_notify.py) */ -}}
{{- $data := site.Data.wiki_updates -}}
{{- $items := slice -}}
{{- with $data }}{{ with .items }}{{ $items = . }}{{ end }}{{ end -}}
{{- $limit := 3 -}}
{{- with $data }}{{ with .home_items }}{{ $limit = . }}{{ end }}{{ end -}}
{{- if .IsNamedParams }}{{ with .Get "limit" }}{{ $limit = (int .) }}{{ end }}{{ end -}}
{{- $showArchive := eq ($.Page.RelPermalink) "/" -}}

{{- with $items }}
<section class="wiki-updates">
  <header class="wiki-updates-head">
    <h2>Update Wiki</h2>
    <p class="wiki-updates-sub">Catatan terbaru dari <a href="https://wiki.iraamalia.id" target="_blank" rel="noopener">wiki.iraamalia.id</a></p>
  </header>
  {{- range first $limit . }}
  <article class="wiki-update-card">
    <div class="wiki-update-top">
      <span class="wiki-badge wiki-badge--{{ .badge }}">{{ if eq .badge "baru" }}Baru{{ else }}Diperbarui{{ end }}</span>
      <a class="wiki-update-title" href="{{ .url }}" target="_blank" rel="noopener">{{ .title }}</a>
    </div>
    <p class="wiki-update-summary">{{ .summary }}</p>
    <a class="wiki-update-link" href="{{ .url }}" target="_blank" rel="noopener">Baca halaman di wiki &rarr;</a>
  </article>
  {{- end }}
  {{- if $showArchive }}
  <p class="wiki-updates-more"><a href="/update/">Lihat semua update wiki &rarr;</a></p>
  {{- end }}
</section>
{{- end }}
